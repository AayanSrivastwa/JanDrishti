# JanDrishti Environment Variables

# Supabase Auth & Database (Required for full auth session sync, optional for prototype mock auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional: External Backend API URL
# Leave empty on Vercel to use the built-in serverless /api route,
# or set to your standalone backend URL (e.g. https://jandrishti-api.onrender.com/api)
VITE_BACKEND_URL=
